{
  "name": "hqoverlord",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first operating system for agent-powered businesses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "control-centre": "node apps/control-centre/src/main.ts",
    "build:web": "npm run build --workspace @hqoverlord/control-centre",
    "live:acceptance": "node scripts/live-acceptance.ts",
    "live:openai": "node scripts/real-ai-ignition.mts",
    "business:001:preview": "node businesses/business-001/preview.ts",
    "business:001:bootstrap": "node businesses/business-001/bootstrap.ts",
    "test:business-001": "node --test businesses/business-001/test/*.test.ts",
    "test": "node --test packages/core/test/*.test.ts packages/events/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
